# Local development template. Keep real values in backend/.env; never commit them.
NODE_ENV=development
PORT=8787
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/postgres?sslmode=require
FRONTEND_ORIGIN=http://localhost:5173
BACKEND_PUBLIC_URL=http://localhost:8787
COOKIE_SECURE=false
ALLOW_REGISTRATION=true

# Supabase project URL must be the project root, without /rest/v1 or /auth/v1.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=

# Server-only provider credentials required for real generation.
AI_PROVIDER=groq
# Ordered fallback list; supported values are groq, gemini, and openrouter.
PROVIDER_ORDER=groq,gemini,openrouter
# Vanilla creates use one HTML request and split inline assets after generation.
SINGLE_REQUEST_MODE=true
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_MODEL=
AI_MODEL=openai/gpt-oss-120b
AI_CODER_MODEL=openai/gpt-oss-120b
AI_FALLBACK_MODEL=gemini-2.5-flash
FIRST_BYTE_TIMEOUT_MS=30000
STREAM_IDLE_TIMEOUT_MS=30000
TOTAL_DEADLINE_MS=60000
AI_GENERATION_TOTAL_TIMEOUT_MS=120000

# Public VITE_* values belong in the repository-root .env. The Vite config
# temporarily falls back to these keys here for existing local setups.
# Never put the Supabase service-role key in this file.
