# Local development template. Keep real values in backend/.env; never commit them.
NODE_ENV=development
PORT=8787
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/postgres?sslmode=require
FRONTEND_ORIGIN=http://localhost:5173
BACKEND_PUBLIC_URL=http://localhost:8787
COOKIE_SECURE=false
ALLOW_REGISTRATION=true

# Supabase project URL must be the project root, without /rest/v1 or /auth/v1.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=

# Server-only provider credentials required for real generation.
AI_PROVIDER=groq
AI_FALLBACK_PROVIDER=gemini
GROQ_API_KEY=
GEMINI_API_KEY=
AI_MODEL=openai/gpt-oss-120b
AI_CODER_MODEL=qwen/qwen3.8-27b
AI_FALLBACK_MODEL=gemini-3.8-flash

# Public VITE_* values belong in the repository-root .env. The Vite config
# temporarily falls back to these keys here for existing local setups.
# Never put the Supabase service-role key in this file.
