# Private API configuration. Copy this file to backend/.env for Compose production.
NODE_ENV=production
PORT=8787
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/postgres?sslmode=require
SUPABASE_DB_CA_CERT_PATH=certs/prod-ca-2021.crt
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
FRONTEND_ORIGIN=https://dguy.example.com
COOKIE_SECURE=true
TRUST_PROXY=1
ALLOW_REGISTRATION=true

# Server-only AI provider credentials.
AI_PROVIDER=groq
AI_FALLBACK_PROVIDER=gemini
GROQ_API_KEY=
GEMINI_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
AI_CODER_MODEL=qwen/qwen3.8-27b
AI_MODEL=openai/gpt-oss-120b
AI_FALLBACK_MODEL=gemini-3.8-flash
AI_GENERATION_TOTAL_TIMEOUT_MS=110000
