{
  "name": "dguy-api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run db:generate && tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "db:generate": "prisma generate",
    "db:check": "tsx src/databaseCheck.ts",
    "db:status": "prisma migrate status",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "ai:gemini:probe": "node dist/geminiProbe.js",
    "admin:bootstrap": "tsx src/adminBootstrap.ts",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@huggingface/inference": "4.13.32",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "pg": "^8.23.1",
    "pino": "^9.9.4",
    "postcss": "^8.5.33",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.5.2",
    "prisma": "^7.10.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^5.1.0"
  }
}
