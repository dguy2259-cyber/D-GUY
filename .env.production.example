# Public browser settings. The anon/publishable key is intentionally public.
VITE_API_BASE_URL=
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=

# Compose/API production settings. Replace the example origin before deployment.
NODE_ENV=production
FRONTEND_ORIGIN=https://dguy.example.com
COOKIE_SECURE=true
TRUST_PROXY=1
DGUY_WEB_BIND=0.0.0.0
DGUY_WEB_PORT=8080
