# Public browser configuration only. Copy to .env and fill the Supabase project values.
VITE_API_BASE_URL=
VITE_PORT=5173
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=

# Local Compose defaults. Production deployments should use .env.production.example.
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:8080
COOKIE_SECURE=false
TRUST_PROXY=0
DGUY_WEB_BIND=127.0.0.1
DGUY_WEB_PORT=8080
DGUY_API_TARGET=http://127.0.0.1:8787
